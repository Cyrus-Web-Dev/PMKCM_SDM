APP_NAME="SDM PMKCM V"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Buka aplikasi lewat alamat INI PERSIS (127.0.0.1 dan localhost dianggap situs berbeda oleh browser).
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (buat dulu database kosong di PostgreSQL: CREATE DATABASE sdm_pmkcm;) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sdm_pmkcm
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SESSION_DRIVER=file
SESSION_LIFETIME=120
# PENTING utk PRODUCTION: set true kalau situs sudah pakai HTTPS.
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# SDM V2 tidak mengirim email otomatis (tanpa verifikasi login / Gmail API).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sdm-pmkcm.local"
MAIL_FROM_NAME="SDM PMKCM V"

# --- Pengaturan absensi ---
SDM_LATE_TOLERANCE_MINUTES=10
SDM_IDLE_TIMEOUT_MINUTES=30
SDM_WORK_START_TIME=08:00
SDM_WORK_END_TIME=17:00
SDM_WORK_DAYS_PER_WEEK=5

# Backup database (menu Backup Data): jumlah file yang disimpan
SDM_BACKUP_KEEP=10
# Opsional bila pg_dump tidak ditemukan otomatis, mis. C:\PostgreSQL\16\bin\pg_dump.exe
SDM_PG_DUMP_PATH=

# --- REST API (opsional, mobile/integrasi) ---
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
CORS_ALLOWED_ORIGINS=

# --- Hari libur nasional (dataset publik; punya cache + file cadangan bawaan) ---
SDM_HOLIDAY_API=true
SDM_HOLIDAY_SOURCE_URL=https://raw.githubusercontent.com/guangrei/APIHariLibur_V2/main/calendar.min.json
SDM_HOLIDAY_CACHE_HOURS=12

# --- Geofencing absensi (opsional; kosongkan LAT/LNG untuk menonaktifkan) ---
SDM_OFFICE_LAT=
SDM_OFFICE_LNG=
SDM_OFFICE_RADIUS_M=200
SDM_GEOFENCE_ENFORCE=false

# --- Notifikasi WhatsApp (Fonnte) & Telegram (opsional; nonaktif bila kosong) ---
FONNTE_TOKEN=
SDM_WHATSAPP_ADMIN_NUMBER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Keamanan tambahan untuk PRODUCTION ---
SDM_CSP=off
SDM_FORCE_HTTPS=false

# --- Hashing password ---
HASH_DRIVER=argon2id
ARGON_MEMORY=37888
ARGON_TIME=3
ARGON_THREADS=1

# Akun super-admin awal, dibuat otomatis saat `php artisan migrate --seed`
SDM_ADMIN_NAME="Administrator SDM"
SDM_ADMIN_EMAIL=
SDM_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
